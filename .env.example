# Copy to .env and fill in what you use. Every entry is optional: a source
# without its credential or directory is skipped by ./sync.sh with a warning.

# --- paths -----------------------------------------------------------------
# The canonical database. Default: data/hobbyjogging.db
# HOBBYJOGGING_DB=~/training/hobbyjogging.db

# The FIT archive (Garmin GDPR export or `garmin fetch`). Default: data/fit
# HOBBYJOGGING_FIT_DIR=~/training/fit

# The generated dashboard. Default: data/dashboard
# HOBBYJOGGING_DASHBOARD_DIR=~/training/dashboard

# The lab notebook (experiment scripts and the candidate table). Default:
# ./experiments, which ships the bench rules and the template only.
# HOBBYJOGGING_LAB_DIR=~/projects/laufen_private/lab

# Where the lab shell writes plots. Default: data/lab
# HOBBYJOGGING_LAB_OUTPUT_DIR=~/training/lab

# The Strava bulk-export drop directory (newest export_*.zip is imported).
# Default: data/strava
# HOBBYJOGGING_STRAVA_DIR=~/training/strava

# Per-athlete source policy. Default: ./sources.toml
# HOBBYJOGGING_SOURCES=./sources.toml

# --- credentials -----------------------------------------------------------
# Garmin Connect Personal API key (exchanged for a 24 h bearer token).
# GARMIN_PERSONAL_API_KEY=

# Intervals.icu athlete id and API key. Leave both unset for a Runalyze-only
# install and disable intervals in sources.toml (or let sync skip it).
# INTERVALS_ATHLETE_ID=
# INTERVALS_API_KEY=

# Runalyze personal API token.
# RUNALYZE_API_KEY=
